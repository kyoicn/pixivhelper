{
  "ext_name": {
    "message": "Helper for Pixiv"
  },
  "ext_description": {
    "message": "pixivの作品をワンクリックで保存。すべての原寸画像、metadata.json、うごイラのMP4/WebMを1つのフォルダーにまとめます。"
  },
  "locale_tag": {
    "message": "ja"
  },
  "btn_download": {
    "message": "ダウンロード"
  },
  "hint_pages": {
    "message": "$N$P",
    "placeholders": {
      "n": {
        "content": "$1",
        "example": "12"
      }
    }
  },
  "hint_format": {
    "message": "$FORMAT$",
    "placeholders": {
      "format": {
        "content": "$1",
        "example": "MP4"
      }
    }
  },
  "btn_progress_pages": {
    "message": "$DONE$ / $TOTAL$",
    "placeholders": {
      "done": {
        "content": "$1",
        "example": "7"
      },
      "total": {
        "content": "$2",
        "example": "12"
      }
    }
  },
  "btn_progress_percent": {
    "message": "$P$%",
    "placeholders": {
      "p": {
        "content": "$1",
        "example": "40"
      }
    }
  },
  "btn_cancel": {
    "message": "キャンセル"
  },
  "tip_cancel": {
    "message": "ダウンロードをキャンセル"
  },
  "btn_saved": {
    "message": "保存済み"
  },
  "tip_saved": {
    "message": "Downloads/$FOLDER$ に保存しました",
    "placeholders": {
      "folder": {
        "content": "$1",
        "example": "pixiv/みずき-135882741"
      }
    }
  },
  "btn_login": {
    "message": "ログインして保存"
  },
  "tip_login": {
    "message": "pixivのログインページを開き、ログイン後にこのページへ戻ります"
  },
  "btn_retry": {
    "message": "再試行"
  },
  "hint_failed": {
    "message": "$N$件失敗",
    "placeholders": {
      "n": {
        "content": "$1",
        "example": "12"
      }
    }
  },
  "tip_partial": {
    "message": "$TOTAL$ページ中$SAVED$ページを保存しました。$FAILED$ページはそれぞれ4回試行しても失敗しました。クリックすると、その$FAILED$ページだけを再試行します。",
    "placeholders": {
      "saved": {
        "content": "$1",
        "example": "10"
      },
      "total": {
        "content": "$2",
        "example": "12"
      },
      "failed": {
        "content": "$3",
        "example": "2"
      }
    }
  },
  "tip_partial_one": {
    "message": "$TOTAL$ページ中$SAVED$ページを保存しました。1ページは4回試行しても失敗しました。クリックすると、そのページだけを再試行します。",
    "placeholders": {
      "saved": {
        "content": "$1",
        "example": "10"
      },
      "total": {
        "content": "$2",
        "example": "12"
      }
    }
  },
  "tip_offline": {
    "message": "インターネットに接続されていません。オンラインに戻ってから再試行してください。"
  },
  "tip_refused": {
    "message": "pixivがこの作品の取得を拒否しました。ログインしている場合は、pixivのR-18表示設定を確認してください。"
  },
  "tip_server": {
    "message": "pixivが応答していません。数分後に再試行してください。"
  },
  "tip_disk": {
    "message": "Chromeがダウンロードフォルダーに保存できませんでした。空き容量を確認して、もう一度お試しください。"
  },
  "tip_metadata_only": {
    "message": "全$TOTAL$ページを保存しました。metadata.jsonを保存できませんでした。クリックすると再試行します。",
    "placeholders": {
      "total": {
        "content": "$1",
        "example": "12"
      }
    }
  },
  "btn_unavailable": {
