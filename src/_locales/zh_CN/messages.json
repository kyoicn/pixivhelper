{
  "ext_name": {
    "message": "Helper for Pixiv"
  },
  "ext_description": {
    "message": "一键保存整个 pixiv 作品：全部原图、metadata.json，以及 MP4 或 WebM 格式的动图，统一存入一个文件夹。"
  },
  "locale_tag": {
    "message": "zh-CN"
  },
  "btn_download": {
    "message": "下载"
  },
  "hint_pages": {
    "message": "$N$P",
    "placeholders": {
      "n": {
        "content": "$1",
        "example": "12"
      }
    }
  },
  "hint_format": {
    "message": "$FORMAT$",
    "placeholders": {
      "format": {
        "content": "$1",
        "example": "MP4"
      }
    }
  },
  "btn_progress_pages": {
    "message": "$DONE$ / $TOTAL$",
    "placeholders": {
      "done": {
        "content": "$1",
        "example": "7"
      },
      "total": {
        "content": "$2",
        "example": "12"
      }
    }
  },
  "btn_progress_percent": {
    "message": "$P$%",
    "placeholders": {
      "p": {
        "content": "$1",
        "example": "40"
      }
    }
  },
  "btn_cancel": {
    "message": "取消"
  },
  "tip_cancel": {
    "message": "取消下载"
  },
  "btn_saved": {
    "message": "已保存"
  },
  "tip_saved": {
    "message": "已保存到 Downloads/$FOLDER$",
    "placeholders": {
      "folder": {
        "content": "$1",
        "example": "pixiv/みずき-135882741"
      }
    }
  },
  "btn_login": {
    "message": "登录后下载"
  },
  "tip_login": {
    "message": "打开 pixiv 登录页面，登录后返回此页"
  },
  "btn_retry": {
    "message": "重试"
  },
  "hint_failed": {
    "message": "$N$ 个失败",
    "placeholders": {
      "n": {
        "content": "$1",
        "example": "12"
      }
    }
  },
  "tip_partial": {
    "message": "共 $TOTAL$ 页，已保存 $SAVED$ 页。$FAILED$ 页各尝试 4 次后仍失败。点击仅重试这 $FAILED$ 页。",
    "placeholders": {
      "saved": {
        "content": "$1",
        "example": "10"
      },
      "total": {
        "content": "$2",
        "example": "12"
      },
      "failed": {
        "content": "$3",
        "example": "2"
      }
    }
  },
  "tip_partial_one": {
    "message": "共 $TOTAL$ 页，已保存 $SAVED$ 页。1 页尝试 4 次后仍失败。点击仅重试该页。",
