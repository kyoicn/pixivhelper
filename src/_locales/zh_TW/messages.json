{
  "ext_name": {
    "message": "Helper for Pixiv"
  },
  "ext_description": {
    "message": "一鍵儲存整個 pixiv 作品：所有原圖、metadata.json，以及 MP4 或 WebM 格式的動圖，統一存入一個資料夾。"
  },
  "locale_tag": {
    "message": "zh-TW"
  },
  "btn_download": {
    "message": "下載"
  },
  "hint_pages": {
    "message": "$N$P",
    "placeholders": {
      "n": {
        "content": "$1",
        "example": "12"
      }
    }
  },
  "hint_format": {
    "message": "$FORMAT$",
    "placeholders": {
      "format": {
        "content": "$1",
        "example": "MP4"
      }
    }
  },
  "btn_progress_pages": {
    "message": "$DONE$ / $TOTAL$",
    "placeholders": {
      "done": {
        "content": "$1",
        "example": "7"
      },
      "total": {
        "content": "$2",
        "example": "12"
      }
    }
  },
  "btn_progress_percent": {
    "message": "$P$%",
    "placeholders": {
      "p": {
        "content": "$1",
        "example": "40"
      }
    }
  },
  "btn_cancel": {
    "message": "取消"
  },
  "tip_cancel": {
    "message": "取消下載"
  },
  "btn_saved": {
    "message": "已儲存"
  },
  "tip_saved": {
    "message": "已儲存至 Downloads/$FOLDER$",
    "placeholders": {
      "folder": {
        "content": "$1",
        "example": "pixiv/みずき-135882741"
      }
    }
  },
  "btn_login": {
    "message": "登入後下載"
  },
  "tip_login": {
    "message": "開啟 pixiv 登入頁面，登入後返回此頁"
  },
  "btn_retry": {
    "message": "重試"
  },
  "hint_failed": {
    "message": "$N$ 個失敗",
