      "n": {
        "content": "$1",
        "example": "12"
      }
    }
  },
  "tip_partial": {
    "message": "共 $TOTAL$ 頁，已儲存 $SAVED$ 頁。$FAILED$ 頁各嘗試 4 次後仍失敗。點擊僅重試這 $FAILED$ 頁。",
    "placeholders": {
      "saved": {
        "content": "$1",
        "example": "10"
      },
      "total": {
        "content": "$2",
        "example": "12"
      },
      "failed": {
        "content": "$3",
        "example": "2"
      }
    }
  },
  "tip_partial_one": {
    "message": "共 $TOTAL$ 頁，已儲存 $SAVED$ 頁。1 頁嘗試 4 次後仍失敗。點擊僅重試該頁。",
